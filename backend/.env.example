# FindH Backend Environment Variables
# Copy this to .env for local development
# Set all these as environment variables on Railway/Render for production

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-at-least-32-chars

# ─── Nodemailer / SMTP ───────────────────────────────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# ─── CORS origin (your Vercel frontend URL) ──────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── Optional: Google Maps Geocoding API key ─────────────────────────────────
# GEOCODE_API_KEY=your-google-maps-api-key
